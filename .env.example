# ───────────────────────────────────────────────────────────────
# LabSync AI - environment configuration
# Copy to .env and edit. NEVER commit the real .env file.
# ───────────────────────────────────────────────────────────────

# --- Server -----------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of the app (used in e-mail links, QR codes and CSRF origin checks)
APP_BASE_URL=http://localhost:3000
# Set to true when running behind a reverse proxy / load balancer (Nginx, Render, Railway...)
TRUST_PROXY=false

# --- Security (REQUIRED in production) --------------------------
# Long random string (>= 32 chars). Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It signs session cookies and keys the room-code hashes. Changing it signs everyone out and invalidates existing room codes.
JWT_SECRET=

# --- Initial administrator --------------------------------------
# Created automatically on first start if no admin exists. Change the password immediately.
# Production start is refused while ADMIN_PASSWORD is still the placeholder below.
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe-LabSync-2026!
ADMIN_NAME=System Administrator

# --- Registration policy ----------------------------------------
# Students are activated immediately when true; otherwise an admin must approve them. Staff always need approval.
AUTO_APPROVE_STUDENTS=true
# Require clicking the e-mail verification link before sign-in (needs SMTP below in production).
REQUIRE_EMAIL_VERIFICATION=false
# Optional comma-separated allow-list of e-mail domains, e.g. college.edu,students.college.edu
ALLOWED_EMAIL_DOMAINS=

# --- Storage ----------------------------------------------------
DATABASE_PATH=./data/labsync.db
UPLOAD_DIR=./data/uploads

# --- Gemini AI (optional; AI endpoints report "not configured" without it) ---
# Get a key at https://aistudio.google.com/apikey  - it stays on the server and is never sent to the browser.
GEMINI_API_KEY=
# Default model. Any model your key can access works (e.g. gemini-3.5-flash, gemini-3.8-flash). Admins can override it in System Settings.
GEMINI_MODEL=gemini-3.5-flash

# --- E-mail (optional; without it, verification/reset links are printed in the server log and shown in the UI in development) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LabSync AI <no-reply@yourcollege.edu>

# Show verification/reset links in API responses when SMTP is not configured. Always false in production unless set.
DEV_EXPOSE_LINKS=true
